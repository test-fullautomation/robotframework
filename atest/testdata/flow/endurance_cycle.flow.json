{
  "flow": { "name": "Endurance Cycle", "version": 1 },
  "imports": { "libraries": ["FlowStubs.py"] },
  "variables": { "RIG": "RIG_A" },

  "nodes": [
    { "id": "start",    "kind": "start" },
    { "id": "setup",    "kind": "phase", "role": "setup" },
    { "id": "chamber",  "kind": "gate",    "keyword": "Signal Should Be", "args": ["bench.chamber.state", "==", 1],
                                            "timeout": "5s", "interval": "0.1s" },
    { "id": "power",    "kind": "keyword", "keyword": "Power On DUT", "args": ["${RIG}"] },
    { "id": "mode0",    "kind": "gate",    "keyword": "Signal Should Be", "args": ["bench.mode", "!=", 0], "timeout": "2s" },

    { "id": "cycle",    "kind": "phase", "role": "test", "name": "Cycle" },
    { "id": "loop",     "kind": "loop",    "max_loops": 3, "max_seconds": "1min", "every": "0.1s" },
    { "id": "run",      "kind": "keyword", "keyword": "Run Cycle Tests", "args": ["${RIG}"] },
    { "id": "mode1",    "kind": "gate",    "keyword": "Signal Should Be", "args": ["bench.mode", "!=", 0], "timeout": "2s" },
    { "id": "recover",  "kind": "keyword", "keyword": "Recover DUT", "args": ["${RIG}"] },

    { "id": "teardown", "kind": "phase", "role": "teardown" },
    { "id": "bstd",     "kind": "keyword", "keyword": "Release Bench" },
    { "id": "mode2",    "kind": "gate",    "keyword": "Signal Should Be", "args": ["bench.mode", "!=", 0], "timeout": "2s" },
    { "id": "end",      "kind": "end" }
  ],

  "edges": [
    ["start", "setup"], ["setup", "chamber"], ["chamber", "power"], ["power", "mode0"],
    ["mode0", "cycle"], ["cycle", "loop"],
    { "from": "loop",    "to": "run",      "label": "body" },
    ["run", "mode1"],
    { "from": "mode1",   "to": "loop",     "label": "next" },
    { "from": "loop",    "to": "recover",  "label": "on_failure" },
    { "from": "recover", "to": "loop",     "label": "continue" },
    { "from": "loop",    "to": "teardown", "label": "done" },
    ["teardown", "bstd"], ["bstd", "mode2"], ["mode2", "end"]
  ]
}
