{
  "flow": { "name": "Variable Bounds" },
  "imports": { "libraries": ["FlowStubs.py"] },
  "variables": { "CYCLES": 2, "MAX_TIME": "1 min", "PACE": "0s" },
  "nodes": [
    { "id": "start", "kind": "start" },
    { "id": "loop", "kind": "loop", "max_loops": "${CYCLES}", "max_seconds": "${MAX_TIME}", "every": "${PACE}" },
    { "id": "count", "kind": "keyword", "keyword": "Count Iteration" },
    { "id": "end", "kind": "end" }
  ],
  "edges": [
    ["start", "loop"],
    { "from": "loop", "to": "count", "label": "body" },
    { "from": "count", "to": "loop", "label": "next" },
    { "from": "loop", "to": "end", "label": "done" }
  ]
}
