{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Robot Framework",
  "scopeName": "source.robotframework",
  "fileTypes": [
    "robot",
    "resource"
  ],
  "patterns": [
    {
      "begin": "(?i)^(\\*+\\s*(?:Settings?)\\s*\\**)(.*)$",
      "beginCaptures": {
        "1": {
          "name": "entity.name.section.robotframework markup.heading.robotframework"
        },
        "2": {
          "name": "comment.line.robotframework"
        }
      },
      "end": "^(?=\\*)",
      "name": "meta.section.settings.robotframework",
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "match": "(?i)^(Documentation)((?: {2,}|\\t| \\| )+)(.*)$",
          "captures": {
            "1": {
              "name": "storage.type.setting.robotframework"
            },
            "3": {
              "name": "string.unquoted.documentation.robotframework"
            }
          }
        },
        {
          "comment": "imports: the library, resource or variable file",
          "match": "(?i)^(Library|Resource|Variables)((?: {2,}|\\t| \\| )+)([^\\s#](?:[^\\t ]| (?! ))*)?",
          "captures": {
            "1": {
              "name": "storage.type.setting.robotframework"
            },
            "3": {
              "name": "entity.name.namespace.robotframework",
              "patterns": [
                {
                  "include": "#variables"
                }
              ]
            }
          }
        },
        {
          "comment": "setups and teardowns, templates: the next cell is a keyword",
          "match": "(?i)^((?:Suite|Test|Task) (?:Setup|Teardown)|(?:Test|Task) Template)((?: {2,}|\\t| \\| )+)([^\\s#](?:[^\\t ]| (?! ))*)?",
          "captures": {
            "1": {
              "name": "storage.type.setting.robotframework"
            },
            "3": {
              "name": "support.function.robotframework",
              "patterns": [
                {
                  "include": "#variables"
                }
              ]
            }
          }
        },
        {
          "match": "^([^\\s#.](?:[^\\t ]| (?! ))*)",
          "captures": {
            "1": {
              "name": "storage.type.setting.robotframework"
            }
          }
        },
        {
          "match": "^(\\s*)(\\.\\.\\.)(?=\\s|$)",
          "captures": {
            "2": {
              "name": "punctuation.separator.continuation.robotframework"
            }
          }
        },
        {
          "include": "#comment"
        },
        {
          "include": "#variables"
        },
        {
          "comment": "name=value argument",
          "match": "(?<=  |\\t)([A-Za-z_][\\w ]*?)(=)(?!=)",
          "captures": {
            "1": {
              "name": "variable.parameter.robotframework"
            },
            "2": {
              "name": "keyword.operator.assignment.robotframework"
            }
          }
        },
        {
          "comment": "IN, IN RANGE, AND, ELSE inside a line",
          "match": "(?<=  |\\t)(IN RANGE|IN ENUMERATE|IN ZIP|IN|AND|ELSE IF|ELSE|AS|type=|limit=|on_limit=)(?= {2,}|\\t| \\||\\s*$)",
          "name": "keyword.control.robotframework"
        }
      ]
    },
    {
      "begin": "(?i)^(\\*+\\s*(?:Variables?)\\s*\\**)(.*)$",
      "beginCaptures": {
        "1": {
          "name": "entity.name.section.robotframework markup.heading.robotframework"
        },
        "2": {
          "name": "comment.line.robotframework"
        }
      },
      "end": "^(?=\\*)",
      "name": "meta.section.variables.robotframework",
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "match": "^([$@&]\\{[^}]*\\})(\\s?=)?",
          "captures": {
            "1": {
              "name": "variable.other.definition.robotframework"
            },
            "2": {
              "name": "keyword.operator.assignment.robotframework"
            }
          }
        },
        {
          "match": "^(\\s*)(\\.\\.\\.)(?=\\s|$)",
          "captures": {
            "2": {
              "name": "punctuation.separator.continuation.robotframework"
            }
          }
        },
        {
          "include": "#comment"
        },
        {
          "include": "#variables"
        },
        {
          "comment": "name=value argument",
          "match": "(?<=  |\\t)([A-Za-z_][\\w ]*?)(=)(?!=)",
          "captures": {
            "1": {
              "name": "variable.parameter.robotframework"
            },
            "2": {
              "name": "keyword.operator.assignment.robotframework"
            }
          }
        },
        {
          "comment": "IN, IN RANGE, AND, ELSE inside a line",
          "match": "(?<=  |\\t)(IN RANGE|IN ENUMERATE|IN ZIP|IN|AND|ELSE IF|ELSE|AS|type=|limit=|on_limit=)(?= {2,}|\\t| \\||\\s*$)",
          "name": "keyword.control.robotframework"
        }
      ]
    },
    {
      "begin": "(?i)^(\\*+\\s*(?:Test Cases?|Tasks?|Keywords?)\\s*\\**)(.*)$",
      "beginCaptures": {
        "1": {
          "name": "entity.name.section.robotframework markup.heading.robotframework"
        },
        "2": {
          "name": "comment.line.robotframework"
        }
      },
      "end": "^(?=\\*)",
      "name": "meta.section.body.robotframework",
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "comment": "a test, task or keyword: its name at the start of the line",
          "match": "^(?![\\s#*]|\\.\\.\\.)([^\\s#](?:[^\\t ]| (?! ))*)",
          "captures": {
            "1": {
              "name": "entity.name.function.robotframework",
              "patterns": [
                {
                  "include": "#variables"
                }
              ]
            }
          }
        },
        {
          "comment": "documentation",
          "match": "(?i)^(\\s+)(\\[Documentation\\])(.*)$",
          "captures": {
            "2": {
              "name": "keyword.other.setting.robotframework"
            },
            "3": {
              "name": "string.unquoted.documentation.robotframework"
            }
          }
        },
        {
          "comment": "[Setup] / [Teardown] / [Template]: the next cell is a keyword",
          "match": "(?i)^(\\s+)(\\[(?:Setup|Teardown|Template)\\])((?: {2,}|\\t| \\| )+)([^\\s#](?:[^\\t ]| (?! ))*)?",
          "captures": {
            "2": {
              "name": "keyword.other.setting.robotframework"
            },
            "4": {
              "name": "support.function.robotframework",
              "patterns": [
                {
                  "include": "#variables"
                }
              ]
            }
          }
        },
        {
          "match": "^(\\s+)(\\[[^\\]]+\\])",
          "captures": {
            "2": {
              "name": "keyword.other.setting.robotframework"
            }
          }
        },
        {
          "comment": "control structures",
          "match": "^(\\s+)(FOR|END|IF|ELSE IF|ELSE|WHILE|TRY|EXCEPT|FINALLY|BREAK|CONTINUE|RETURN|VAR|GROUP|THREAD)(?= {2,}|\\t| \\||\\s*$)",
          "captures": {
            "2": {
              "name": "keyword.control.robotframework"
            }
          }
        },
        {
          "match": "^(\\s*)(\\.\\.\\.)(?=\\s|$)",
          "captures": {
            "2": {
              "name": "punctuation.separator.continuation.robotframework"
            }
          }
        },
        {
          "match": "^(\\s+)((?:[$@&]\\{[^}]*\\}\\s?=?(?: {2,}|\\t| \\| )+)*)([^\\s#](?:[^\\t ]| (?! ))*)",
          "captures": {
            "1": {},
            "2": {
              "patterns": [
                {
                  "include": "#variables"
                }
              ]
            },
            "3": {
              "name": "support.function.robotframework",
              "patterns": [
                {
                  "include": "#variables"
                }
              ]
            }
          }
        },
        {
          "include": "#comment"
        },
        {
          "include": "#variables"
        },
        {
          "comment": "name=value argument",
          "match": "(?<=  |\\t)([A-Za-z_][\\w ]*?)(=)(?!=)",
          "captures": {
            "1": {
              "name": "variable.parameter.robotframework"
            },
            "2": {
              "name": "keyword.operator.assignment.robotframework"
            }
          }
        },
        {
          "comment": "IN, IN RANGE, AND, ELSE inside a line",
          "match": "(?<=  |\\t)(IN RANGE|IN ENUMERATE|IN ZIP|IN|AND|ELSE IF|ELSE|AS|type=|limit=|on_limit=)(?= {2,}|\\t| \\||\\s*$)",
          "name": "keyword.control.robotframework"
        }
      ]
    },
    {
      "begin": "(?i)^(\\*+\\s*(?:Comments?)\\s*\\**)(.*)$",
      "beginCaptures": {
        "1": {
          "name": "entity.name.section.robotframework markup.heading.robotframework"
        },
        "2": {
          "name": "comment.line.robotframework"
        }
      },
      "end": "^(?=\\*)",
      "name": "meta.section.comments.robotframework",
      "patterns": [
        {
          "name": "comment.block.robotframework",
          "match": ".+"
        }
      ]
    },
    {
      "include": "#comment"
    }
  ],
  "repository": {
    "comment": {
      "patterns": [
        {
          "name": "comment.line.number-sign.robotframework",
          "match": "(?:^|(?<=  |\\t)|(?<=^ ))#.*$"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "meta.embedded.expression.robotframework",
          "match": "\\$\\{\\{.*?\\}\\}"
        },
        {
          "name": "variable.other.robotframework",
          "match": "[$@&%]\\{(?:[^{}]|\\{[^{}]*\\})*\\}(?:\\[[^\\]]*\\])*"
        },
        {
          "name": "constant.character.escape.robotframework",
          "match": "\\\\(?:[ntr\\\\$@&%#=|]|x[0-9a-fA-F]{2})"
        }
      ]
    }
  }
}
